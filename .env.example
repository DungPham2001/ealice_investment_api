NODE_ENV=development
PORT=4000
# MongoDB Atlas (same cluster as the other apps, one database per app: ealicea_investment).
# Local dev: mongodb://127.0.0.1:27017/ealicea_investment
# Transactions (cascade delete) need a replica set: Atlas has one. On a standalone mongod deletes run without a transaction.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ealicea_investment?retryWrites=true&w=majority
# Comma separated. Mobile apps send no Origin, so this only matters for web clients / the admin site.
CORS_ORIGINS=

# Business timezone: "today", period boundaries, year of capex buckets.
TIMEZONE=America/New_York

# Writes must carry X-Attestation (Play Integrity token) when true. Only the header's presence is checked:
# plug the real Google verification into src/middleware/context.js (verifyAttestation) before relying on it.
ATTESTATION_REQUIRED=false

# Rate limits (per install id and per IP). 429 + Retry-After.
DELETE_LIMIT=12
DELETE_WINDOW_MIN=10
WRITE_LIMIT_PER_MIN=120
CREATE_LIMIT_PER_DAY=500

# Required (X-Admin-Key) for /v1/admin/*. Empty = admin endpoints disabled.
ADMIN_KEY=
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /v1/jobs/daily.
CRON_SECRET=
