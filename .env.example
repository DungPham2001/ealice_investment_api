NODE_ENV=development
PORT=4000
# MongoDB Atlas (same cluster as the other apps, one database per app: ealicea_investment).
# Local dev: mongodb://127.0.0.1:27017/ealicea_investment
# Transactions (cascade delete) need a replica set: Atlas has one. On a standalone mongod deletes run without a transaction.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ealicea_investment?retryWrites=true&w=majority
# Comma separated. Mobile apps send no Origin, so this only matters for web clients / the admin site.
CORS_ORIGINS=

# Business timezone: "today", period boundaries, year of capex buckets.
TIMEZONE=America/New_York
